<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style
        name="AppTheme"
        parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar">@bool/light_system_bars</item>
    </style>
    <!-- Consistent AppCompat button roles: primary actions use the accent color,
     secondary actions keep the standard neutral AppCompat treatment. -->
    <style
        name="WalletPrimaryButton"
        parent="Widget.AppCompat.Button.Colored" />
    <style
        name="WalletSecondaryButton"
        parent="Widget.AppCompat.Button" />
</resources>
