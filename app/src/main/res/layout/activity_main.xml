<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="?attr/colorPrimary"
            android:elevation="4dp" />
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="12dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="132dp"
                    android:background="@drawable/bg_blue_card"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="10dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_balance"
                            android:textColor="?android:attr/textColorPrimaryInverse"
                            android:textSize="14sp"
                            android:textIsSelectable="true" />
                        <TextView
                            android:id="@+id/networkBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/network_badge_mainnet"
                            android:textColor="?android:attr/textColorPrimaryInverse"
                            android:textSize="12sp"
                            android:textStyle="bold" />
                        <TextView
                            android:id="@+id/balanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/zero_btc"
                            android:textColor="?android:attr/textColorPrimaryInverse"
                            android:textSize="24sp"
                            android:textStyle="bold"
                            android:textIsSelectable="true" />
                        <TextView
                            android:id="@+id/availableBalanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="7dp"
                            android:text="@string/available_balance_loading"
                            android:textColor="?android:attr/textColorPrimaryInverse"
                            android:textSize="12sp"
                            android:textIsSelectable="true" />
                        <TextView
                            android:id="@+id/pendingBalanceText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/pending_balance_loading"
                            android:textColor="?android:attr/textColorPrimaryInverse"
                            android:textSize="12sp"
                            android:textIsSelectable="true" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/receiveQr"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:clickable="true"
                        android:contentDescription="@string/receive_qr_title"
                        android:focusable="true"
                        android:padding="2dp"
                        android:scaleType="fitCenter" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_card"
                    android:gravity="center_vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">
                            <TextView
                                android:id="@+id/walletTypeText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/wallet_type_main"
                                android:textColor="?android:attr/textColorSecondary"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:textIsSelectable="true" />
                            <ImageButton
                                android:id="@+id/walletSelectorButton"
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="@string/wallet_selector_title"
                                android:padding="8dp"
                                android:src="@drawable/ic_expand_more_24dp"
                                android:tint="?attr/colorControlNormal" />
                        </LinearLayout>
                        <TextView
                            android:id="@+id/addressText"
                            android:maxLines="1"
                            android:ellipsize="middle"
                            android:scrollHorizontally="false"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="@string/loading"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="13sp" />
                    </LinearLayout>
                    <ImageView
                        android:id="@+id/copyAddress"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:clickable="true"
                        android:contentDescription="@string/copy_address"
                        android:focusable="true"
                        android:padding="8dp"
                        android:src="@drawable/ic_content_copy_18dp"
                        android:tint="?attr/colorControlNormal" />
                </LinearLayout>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:padding="14dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/transactions_title"
                            android:textColor="?android:attr/textColorPrimary"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:textIsSelectable="true" />
                        <TextView
                            android:id="@+id/transactionsCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="2dp"
                            android:textColor="?android:attr/textColorSecondary"
                            android:textSize="11sp"
                            android:textIsSelectable="true" />
                        <Button
                            android:id="@+id/transactionsExport"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="0dp"
                            android:text="@string/export_transactions"
                            style="@style/WalletSecondaryButton" />
                        <ImageButton
                            android:id="@+id/transactionsExpand"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/transaction_limit_title"
                            android:padding="8dp"
                            android:src="@drawable/ic_expand_more_24dp"
                            android:tint="?attr/colorControlNormal" />
                    </LinearLayout>
                    <RadioGroup
                        android:id="@+id/transactionFilters"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
                        <RadioButton
                            android:id="@+id/filterAll"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_all"
                            android:textColor="?android:attr/textColorPrimary" />
                        <RadioButton
                            android:id="@+id/filterSent"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_sent"
                            android:textColor="?android:attr/textColorPrimary" />
                        <RadioButton
                            android:id="@+id/filterReceived"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/filter_received"
                            android:textColor="?android:attr/textColorPrimary" />
                    </RadioGroup>
                    <TextView
                        android:id="@+id/transactionsEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="16dp"
                        android:text="@string/no_transactions_yet"
                        android:textColor="?android:attr/textColorSecondary"
                        android:textSize="14sp"
                        android:visibility="gone"
                        android:textIsSelectable="true" />
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/transactionsList"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:layout_marginTop="6dp"
                        android:overScrollMode="never" />
                </LinearLayout>
            </LinearLayout>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>
    <include layout="@layout/layout_download_peers" />
</FrameLayout>
